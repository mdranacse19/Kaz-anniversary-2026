rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // TEMP step 1 — Publish this so rebuild can list votes + write tallies.
    // After rebuild succeeds, replace with firestore.rules (owner-only) and Publish again.
    match /votes/{voterId} {
      allow read, write: if true;
    }
    match /publicTallies/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /voterNames/{nameHash} {
      allow read, write: if true;
    }
  }
}
