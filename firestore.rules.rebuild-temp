rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Votes and OTP challenges are written only by the vote API (Admin SDK).
    // Console (project owner) can still open these documents.
    match /votes/{employeeId} {
      allow read, write: if false;
    }
    match /voteOtps/{employeeId} {
      allow read, write: if false;
    }

    // Public live results: counts only.
    match /publicTallies/{docId} {
      allow read: if true;
      allow write: if false;
    }
  }
}
