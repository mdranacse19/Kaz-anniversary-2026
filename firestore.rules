rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Full vote incl. name/nameKey — owner only via the app.
    // Firebase Console (project owner) can still view all docs for admin export.
    match /votes/{voterId} {
      allow read, create, update, delete:
        if request.auth != null && request.auth.uid == voterId;
    }

    // Public live results: counts only (no names). Site listens here.
    match /publicTallies/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Same-name lock: doc id is SHA-256 hash (not plaintext name).
    match /voterNames/{nameHash} {
      allow read, write: if true;
    }
  }
}
