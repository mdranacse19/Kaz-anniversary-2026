rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Office tour voting — open rules for shared poll.
    // Tighten later after Anonymous Auth is fully enabled.
    match /votes/{voterId} {
      allow read, write: if true;
    }

    // Name lock for the same-name second-browser check.
    // Same open office policy as votes: fallback voter ids are not Firebase Auth uids,
    // so rules cannot prove name ownership. The client transaction is the guard.
    match /voterNames/{nameKey} {
      allow read, write: if true;
    }
  }
}
