# Firebase Admin (service account). Not the public web apiKey.
FIREBASE_PROJECT_ID=kaz-software-8007a
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Mailgun HTTP API. The OTP is sent only from the server.
# Use a Sending API key or private API key, not an SMTP password.
# Europe accounts: MAILGUN_API_BASE=https://api.eu.mailgun.net
MAILGUN_API_KEY=
MAILGUN_DOMAIN=
MAILGUN_API_BASE=https://api.mailgun.net
MAIL_FROM=

# Optional listen port
PORT=8787

# No new vote or code is accepted at or after this instant. Empty = voting stays open.
# Bangladesh time, for example 2026-10-15T23:59:59+06:00
VOTING_CLOSES_AT=

# When true, the page lets a voter change destination or undo. When false, the first vote is final.
ALLOW_CHANGE_VOTE=false

# Vote API origin for the browser. Empty = same origin when deployed, local vote-api on localhost.
VOTE_API_URL=
