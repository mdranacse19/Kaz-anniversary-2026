# Firebase Admin (service account). Not the public web apiKey.
FIREBASE_PROJECT_ID=kaz-software-8007a
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Mailgun HTTP API. The OTP is sent only from the server.
# Use a Sending API key or private API key, not an SMTP password.
# Europe accounts: MAILGUN_API_BASE=https://api.eu.mailgun.net
MAILGUN_API_KEY=
MAILGUN_DOMAIN=
MAILGUN_API_BASE=https://api.mailgun.net
MAIL_FROM=

# Optional listen port
PORT=8787
